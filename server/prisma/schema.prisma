generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  displayName String
  role        UserRole @relation(fields: [roleId], references: [id])
  roleId      Int      @default(1)
}

model UserRole {
  id         Int    @id @default(autoincrement())
  name       String @unique
  permission Int
  users      User[]
}